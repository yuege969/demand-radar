# LLM API (OpenAI-compatible)
# Default: DeepSeek V3 (deepseek-chat), ~$2/M tokens
LLM_API_KEY=
LLM_API_BASE=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# GitHub personal access token (optional, raises rate limit from 10→30 req/min)
GITHUB_TOKEN=

# RSS feeds for demand discovery (comma-separated URLs)
# Built-in defaults include: 阮一峰, V2EX, 36氪, 少数派, 知乎日报
RSS_FEEDS=

# Crawl4AI local browser settings
CRAWL4AI_HEADLESS=true
CRAWL4AI_WORD_COUNT_THRESHOLD=200

# Server
ALLOWED_ORIGINS=http://localhost:3000
DATABASE_URL=sqlite:///./demand_radar.db
MAX_POSTS_PER_BATCH=50
ADMIN_API_TOKEN=

# HTTP proxy for accessing external sites
HTTP_PROXY=

# Crawl anti-detection: jittered delay between requests (seconds)
CRAWL_MIN_DELAY=1.0
CRAWL_MAX_DELAY=3.0
CRAWL_MAX_RETRIES=3
CRAWL_BACKOFF_BASE=2.0
CRAWL_RATE_LIMIT_CONCURRENT=2

# Embedding model for pain point deduplication
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
DEDUP_THRESHOLD=0.85
