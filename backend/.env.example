# LLM API (OpenAI-compatible: DeepSeek/Qwen/Moonshot/Zhipu/OpenAI etc.)
LLM_API_KEY=
LLM_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Firecrawl web search API
FIRECRAWL_API_KEY=
FIRECRAWL_API_BASE=

# Server
ALLOWED_ORIGINS=http://localhost:3000
DATABASE_URL=sqlite:///./demand_radar.db
MAX_POSTS_PER_BATCH=50
ADMIN_API_TOKEN=

# HTTP proxy for accessing external sites (e.g., DuckDuckGo, Zhihu)
HTTP_PROXY=

# Crawl anti-detection: jittered delay between requests (seconds)
CRAWL_MIN_DELAY=1.0
CRAWL_MAX_DELAY=3.0
CRAWL_MAX_RETRIES=3
CRAWL_BACKOFF_BASE=2.0
CRAWL_RATE_LIMIT_CONCURRENT=2

# Embedding model for pain point deduplication
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
DEDUP_THRESHOLD=0.85
